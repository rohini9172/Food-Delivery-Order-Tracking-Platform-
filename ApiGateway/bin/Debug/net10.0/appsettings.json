{
  "Jwt": {
    "Issuer": "IdentityService",
    "Audience": "FoodDeliveryApp",
    "Key": "this_is_a_super_long_secret_key_for_jwt_token_generation_1234567890"
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "identityCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "orderRoute": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "AuthorizationPolicy": "CustomerOnly"
      },
      "cartRoute": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/api/cart/{**catch-all}" },
        "AuthorizationPolicy": "CustomerOnly"
      },
      "restaurantRoute": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/api/restaurants/{**catch-all}" }
      },
      "orderHubRoute": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/orderHub/{**catch-all}" },
        "AuthorizationPolicy": "CustomerOnly"
      },
      "paymentRoute": {
        "ClusterId": "paymentCluster",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "AuthorizationPolicy": "CustomerOnly"
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identity": { "Address": "http://localhost:5007" }
        }
      },
      "orderCluster": {
        "Destinations": {
          "order": { "Address": "http://localhost:5214" }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "payment": { "Address": "http://localhost:5176" }
        }
      }
    }
  }
}
